{
  "name": "paperbot",
  "version": "0.1.0",
  "description": "Convert structured research documents (JSON or Markdown) into polished PDFs via HTML/CSS + Playwright Chromium",
  "private": true,
  "type": "module",
  "main": "./dist/pipeline.js",
  "exports": {
    ".": "./dist/pipeline.js"
  },
  "bin": {
    "paperbot": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "setup": "npm install && npx playwright install chromium"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "marked": "^15.0.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
